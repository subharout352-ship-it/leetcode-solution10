class Solution(object):

    def minCut(self, s):
        """
        :type s: str
        :rtype: int
        """

        n = len(s)

        if n <= 1:
            return 0

        dp = [0] * n
        palindrome = [[False] * n for _ in range(n)]

        for i in range(n):
            dp[i] = i

            for j in range(i + 1):
                if s[j] == s[i] and (i - j <= 1 or palindrome[j + 1][i - 1]):
                    palindrome[j][i] = True

                    if j == 0:
                        dp[i] = 0
                    else:
                        dp[i] = min(dp[i], dp[j - 1] + 1)

        return dp[n - 1]
